{
  "modules": [
    "./pins.ts"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|.*execute_terminal_command|.*run_command|.*shell_command|.*run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/install-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
