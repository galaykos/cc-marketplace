{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|.*execute_terminal_command|.*execute_sql_query|.*run_command|.*shell_command|.*run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/destructive-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/destructive-guard.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
