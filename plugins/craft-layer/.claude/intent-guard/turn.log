import re, pathlib
B = pathlib.Path('.')

def stamp(rel, marker):
    p = B/rel; t = p.read_text()
    lines = t.split('\n')
    # insert after the H1 title line
    i = next(i for i,l in enumerate(lines) if l.startswith('# '))
    lines.insert(i+1, '\n' + marker)
    p.write_text('\n'.join(lines))
    print('stamped', rel)

