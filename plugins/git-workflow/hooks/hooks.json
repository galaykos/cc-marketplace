{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|.*execute_terminal_command|.*run_command|.*shell_command|.*run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/no-ai-trailer.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/no-ai-trailer.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
