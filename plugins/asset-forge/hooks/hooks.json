{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*__execute_blender_code|mcp__plugin_asset-forge_forge__.*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/review-state.sh\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/review-state.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
