{
  "engine": "godot",
  "format": "gltf",
  "up_axis": "Y",
  "gltf": {
    "export_format": "GLB",
    "export_apply": true,
    "export_yup": true,
    "use_selection": true,
    "export_tangents": true,
    "export_extras": true,
    "export_animation_mode": "ACTIONS"
  },
  "naming": {
    "mesh": "^[A-Za-z][A-Za-z0-9_]*$",
    "lod": "{name}_LOD{n}",
    "collision": {
      "box": "{name}-colonly",
      "convex": "{name}-convcolonly",
      "multi": "{name}-convcolonly{nn}"
    },
    "material": "^[A-Za-z][A-Za-z0-9_]*$",
    "texture": "^[a-z0-9_]+_(albedo|normal|orm|emission)$"
  },
  "reserved_suffixes": [
    "-col",
    "-convcol",
    "-colonly",
    "-convcolonly",
    "-rigid",
    "-vehicle",
    "-wheel",
    "-navmesh",
    "-occ",
    "-occonly",
    "-noimp",
    "-alpha",
    "-vcol"
  ],
  "pivot": "bottom_center",
  "lod": {
    "export": "engine_generates",
    "note": "Godot generates mesh LODs on import; export LOD0 only unless hand LODs are wanted"
  },
  "texture_packing": {
    "name": "ORM",
    "R": "ao",
    "G": "roughness",
    "B": "metallic"
  },
  "animation": {
    "clip_naming": "{clip}",
    "root_motion": "AnimationTree root motion track",
    "loop_suffix": "-loop"
  }
}
