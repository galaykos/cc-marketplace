.idea
.superpowers
docs
.junie
taskmaster-docs
# Local Claude Code state — track only settings.json (the committed authoring-guard hook)
# plus the committed project skills below (a parent dir must be unignored before
# anything under it can be re-included).
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
# every project-skill DIRECTORY is tracked as a whole (validate.sh gates each one)
!.claude/skills/*/
# Session tooling state must never ship inside a plugin. The rule above is
# root-anchored (a mid-pattern slash anchors to the .gitignore dir), so nested
# .claude/ dirs were never matched — which is how six per-session state files
# got committed into plugins/craft-layer/. Enforced in scripts/validate.sh.
plugins/**/.claude/
.playwright-mcp/
__pycache__/

# `claude plugin eval` writes its run artifacts into the plugin by default; never tracked
plugins/*/evals/results/

# Mod type declarations and the root tsconfig.json extending them, generated by the CLI (/plugin-types); never tracked
plugins/*/.claude-plugin/types/
plugins/*/tsconfig.json
templates/mods/kit-harness/.claude-plugin/types/
templates/mods/kit-harness/tsconfig.json
