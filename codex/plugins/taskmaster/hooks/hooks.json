{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex-runtime/hooks.py\" hooks/remind.sh UserPromptSubmit '*'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex-runtime/hooks.py\" hooks/ultra.sh UserPromptSubmit '*'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex-runtime/hooks.py\" hooks/clarify-gate.sh PreToolUse 'Edit|Write|MultiEdit'",
            "timeout": 10
          }
        ],
        "matcher": "Edit|Write|MultiEdit|apply_patch"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex-runtime/hooks.py\" hooks/card-lint-observe.sh PostToolUse 'Edit|Write|MultiEdit'",
            "timeout": 10
          }
        ],
        "matcher": "Edit|Write|MultiEdit|apply_patch"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex-runtime/hooks.py\" --notice 'Codex compatibility: Codex has no Claude Artifact event. Follow the taskmaster preview protocol before presenting artifacts.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
