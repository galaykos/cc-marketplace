            "command": "python3 \"${PLUGIN_ROOT}/codex-runtime/hooks.py\" hooks/guard.sh PreToolUse 'Write|Edit|MultiEdit'",
            "timeout": 5
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch"
      }
    ]
  }
}
