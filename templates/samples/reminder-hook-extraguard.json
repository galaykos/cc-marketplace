{
  "chassis": "reminder-hook",
  "regex": "\\b(build|create|add|implement|develop|rewrite|refactor)\\b",
  "message": "taskmaster: feature-shaped prompt with thin detail — pin scope, edge cases, and success criteria before code",
  "command": "/taskmaster:task",
  "extraGuard": "[ \"${#prompt}\" -lt 200 ]",
  "budgetShared": true,
  "artifact": "sample:remind",
  "arcRank": 50,
  "lane": {
    "owns": "sample-signal",
    "trigger": "prompt matches the sample regex",
    "yieldsTo": "-",
    "phase": "build"
  }
}
